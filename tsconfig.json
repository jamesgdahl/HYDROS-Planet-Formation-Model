{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "removeComments": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
